# twiq (frontend) — environment template.
#
# Copy to `.env.local` (dev) or set in the deployment environment (prod).
# NEVER commit real values. Only `NEXT_PUBLIC_*` variables are exposed to
# the client bundle — everything else stays server-side (Next.js API
# routes only).

# =============================================================================
# Client-safe (NEXT_PUBLIC_*) — bundled into the browser.
# =============================================================================

# --- Backend ---------------------------------------------------------------
# twiq-backend base URL — MUST include the trailing /api. All apiCalls in
# src/apiCalls/* construct authed URLs as `${NEXT_PUBLIC_SERVER_URI}/chats/…`
# and expect this env to resolve to the `/api/*` mount on the backend.
# The one exception is the public-share endpoint (Phase 3 §6.16), which the
# backend mounts at `/shared/*` OUTSIDE `/api/*` — shareSession.js strips
# the `/api` suffix before hitting that route.
NEXT_PUBLIC_SERVER_URI=http://localhost:5000/api

# --- Supabase (browser client) ---------------------------------------------
# src/lib/supabase.js constructs the browser Supabase client from these.
# The anon key is safe to expose in the bundle (public by design). Never
# ship the service-role key here — that lives ONLY on the backend.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJREPLACE_ME

# --- Feature flags + config -----------------------------------------------
# Toggle the settings page pricing display between test/live plans.
# src/utils/pricingConfig.js switches src/constants/testPricing.js in
# when this is 'true'.
NEXT_PUBLIC_STRIPE_TEST_MODE=false

# Show / hide the text-to-speech (speaker) button on assistant messages.
# When 'true', wires up the button in
# src/components/carouselComponents/chatMessage/chatMessage.jsx, which
# calls the /api/tts route (needs ELEVENLABS_API_KEY below).
NEXT_PUBLIC_TTS_ENABLED=false

# =============================================================================
# Server-only — read from Next.js API route handlers under src/app/api/*.
# NEVER prefix with NEXT_PUBLIC_ or these leak into the bundle.
# =============================================================================

# ElevenLabs TTS. Used only by src/app/api/tts/route.js. Skip if
# NEXT_PUBLIC_TTS_ENABLED is 'false' — the API route won't be hit.
# ELEVENLABS_API_KEY=sk_REPLACE_ME

# Vercel Cron authentication for src/app/api/keep-warm/route.js. Vercel
# auto-forwards this as `Authorization: Bearer <secret>` when a
# scheduled cron fires (see vercel.json). Set to any random long string
# on Vercel; when unset locally, the route allows unauthed hits so you
# can curl it in dev.
# CRON_SECRET=REPLACE_ME

# =============================================================================
# Build-time flags — set by scripts, not required at runtime.
# =============================================================================

# Set to 'true' to enable the @next/bundle-analyzer during `npm run build`.
# scripts/analyze-bundle.js sets this automatically; you rarely set it
# by hand.
# ANALYZE=false
